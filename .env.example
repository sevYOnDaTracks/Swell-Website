BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000
DATABASE_PATH=swell.db
ADMIN_EMAILS=toi@exemple.com
# Connexion Google (console.cloud.google.com > Identifiants > ID client OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Emails (resend.com) — sans clé, les emails sont seulement écrits dans les journaux
RESEND_API_KEY=
EMAIL_FROM=Swell <contact@swell-audio.fr>
ADMIN_NOTIFY_EMAIL=
CRON_SECRET=change-me

# Paiement par virement : le panier reste fermé tant que ces deux valeurs sont vides
BANK_TRANSFER_IBAN=
BANK_TRANSFER_HOLDER=
# Paiement PayPal : proposé seulement si cette adresse est réglée
PAYPAL_EMAIL=

# Licences des VST : clé privée Ed25519 générée par `node scripts/license-keygen.mjs`.
# Sans elle, les clés s'affichent dans « Mon espace » mais l'activation dans les plugins est refusée.
LICENSE_PRIVATE_KEY=

# Mobile money (Côte d'Ivoire) : numéro qui reçoit les paiements. Sans numéro, le moyen n'est pas proposé.
WAVE_NUMBER=
ORANGE_MONEY_NUMBER=
# Nom affiché à côté du numéro (facultatif), ex. « Swell Audio »
MOBILE_MONEY_NAME=
